{
  "name": "calendar-hana",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && npm --prefix functions run typecheck",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-calendar-hana 'vitest run --config vitest.emulator.config.ts'",
    "emulators": "firebase emulators:start --only auth,firestore",
    "build:functions": "npm --prefix functions run build",
    "test:e2e": "playwright test",
    "ci:local": "npm run lint && npm run typecheck && npm test && npm run test:emulator && python3 scripts/audit-annual-directions-mutations.py && python3 scripts/audit-mansion-content-mutations.py && playwright test --project=desktop --update-snapshots=none && playwright test --config playwright.dev.config.ts --project=desktop --update-snapshots=none && npm run ci:p4",
    "ci:p4": "git diff --quiet origin/main...HEAD -- 'shared/lunar/p4*' 'scripts/audit-p4-*' || (python3 scripts/audit-p4-remaining-ji-mutations.py && python3 scripts/audit-p4-yi-mutations.py --shard=1/1 && python3 scripts/audit-p4-warehouse-mutations.py && python3 scripts/audit-p4-puzhu06-mutations.py && python3 scripts/audit-p4-full-golden-mutations.py)",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "astronomy-engine": "^2.1.19",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "posthog-js": "^1.434.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    }
  },
  "engines": {
    "node": ">=20",
    "npm": ">=11"
  }
}
