  "puzhu:05": {
   "offset": 21790,
   "text": "凡吉凶相抵不註宜亦不註忌者如遇徳猶忌之事則仍註忌"
  },
  "puzhu:06": {
   "offset": 21817,
   "text": "凡徳合赦願月恩四相時徳等日不註忌進人口安牀經絡醖釀開市立劵交易納財開倉庫出貨財如遇徳猶忌及從忌不從宜之日則仍註忌"
  },
  "puzhu:17": {
   "offset": 22146,
   "text": "凡吉凶相抵不註忌嫁娶亦不註忌冠帶結婚姻納采問名進人口般移安牀如遇徳猶忌之日則仍註忌遇不將而不註忌嫁娶者亦仍註忌遇亥日厭對八專四忌四窮而仍註忌嫁娶者止註所忌之事其不忌者仍不註忌"
  },
  "puzhu:20": {
   "offset": 22313,
   "text": "凡吉凶相抵不註忌修造動土豎柱上梁亦不註忌修宫室繕城郭築隄防修倉庫鼓鑄苫葢修置産室開渠穿井安碓磑補垣塞穴修飾垣牆平治道塗破屋壊垣如遇徳猶忌之日則仍註忌"
  },
  "puzhu:21": {
   "offset": 22390,
   "text": "凡吉凶相抵不註忌開市亦不註忌立劵交易納財不註忌納財亦不註忌開市立劵交易不註忌立劵交易亦不註忌開市納財"
  },
  "puzhu:22": {
   "offset": 22443,
   "text": "凡吉凶相抵不註忌開市立劵交易亦不註忌開倉庫出貨財如遇專忌之日則仍註忌"
  }
 },
