{
  "schemaVersion": "1.0.0",
  "resolutionOrder": [
    "raw_rules",
    "contextual_exceptions",
    "conflict_resolution",
    "caps",
    "personal_layer",
    "classification"
  ],
  "items": [
    {
      "id": "de_virtues_reduce_yem_doi",
      "when": {
        "targetPresent": "yem_doi",
        "anyPresent": ["thien_duc", "nguyet_duc", "thien_duc_hop", "nguyet_duc_hop", "thien_xa"]
      },
      "action": "reduce_bad",
      "factor": 0.5,
      "activityIds": ["wedding"],
      "sourcePolicy": "classical_exception_requires_runtime_source_verification",
      "enabled": false
    },
    {
      "id": "month_break_not_auto_cancelled",
      "when": {
        "targetPresent": "nguyet_pha"
      },
      "action": "preserve_bad",
      "activityIds": [
        "wedding",
        "engagement",
        "moving",
        "opening",
        "construction",
        "groundbreaking"
      ],
      "enabled": true
    },
    {
      "id": "dinh_day_blocks_haircut",
      "when": {
        "targetPresent": "dinh_nhat"
      },
      "action": "preserve_bad",
      "activityIds": ["cut_hair"],
      "sourcePolicy": "協紀辨方書 卷十 \"凡丁日忌剃頭亦不註宜整容\": a Đinh day is not marked favourable for haircuts",
      "enabled": true
    },
    {
      "id": "giap_day_blocks_warehouse_opening",
      "when": {
        "targetPresent": "giap_nhat"
      },
      "action": "preserve_bad",
      "activityIds": ["warehouse_opening"],
      "sourcePolicy": "協紀辨方書 卷十 百忌日 \"甲日忌開倉庫出貨財\"; 鋪註條例 \"…亦不註忌開倉庫出貨財如遇專忌之日則仍註忌\": a Giáp day is not marked favourable for opening storehouses",
      "enabled": true
    },
    {
      "id": "at_day_blocks_planting",
      "when": {
        "targetPresent": "at_nhat"
      },
      "action": "preserve_bad",
      "activityIds": ["planting"],
      "sourcePolicy": "協紀辨方書 卷十 百忌日 \"乙日忌栽種\": an Ất day is not marked favourable for planting",
      "enabled": true
    },
    {
      "id": "dan_day_blocks_worship",
      "when": {
        "targetPresent": "bach_ky_dan"
      },
      "action": "preserve_bad",
      "activityIds": ["worship"],
      "sourcePolicy": "協紀辨方書 卷十 百忌日 \"寅日忌祭祀\" (專忌): a Dần day is not marked favourable for worship",
      "enabled": true
    },
    {
      "id": "dau_day_blocks_meeting",
      "when": {
        "targetPresent": "bach_ky_dau"
      },
      "action": "preserve_bad",
      "activityIds": ["meeting"],
      "sourcePolicy": "協紀辨方書 卷十 百忌日 \"酉日忌宴㑹\" (專忌): a Dậu day is not marked favourable for banquets",
      "enabled": true
    },
    {
      "id": "than_day_blocks_bed_installation",
      "when": {
        "targetPresent": "bach_ky_than"
      },
      "action": "preserve_bad",
      "activityIds": ["bed_installation"],
      "sourcePolicy": "協紀辨方書 卷十 百忌日 \"申日忌安牀\" (專忌): a Thân day is not marked favourable for installing a bed",
      "enabled": true
    },
    {
      "id": "mui_day_blocks_medical",
      "when": {
        "targetPresent": "bach_ky_mui"
      },
      "action": "preserve_bad",
      "activityIds": ["medical"],
      "sourcePolicy": "協紀辨方書 卷十 百忌日 \"未日忌求醫療病\" (專忌): a Mùi day is not marked favourable for seeking medical treatment",
