# Copy file này thành .env.local rồi điền giá trị từ Firebase Console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Khóa VAPID cho Web Push (Firebase Console > Cloud Messaging > Web Push certificates).
VITE_FIREBASE_VAPID_KEY=
# true = kết nối Firebase Emulator khi chạy dev.
VITE_USE_FIREBASE_EMULATOR=true
# PostHog (chỉ gửi dữ liệu ở bản build trên domain thật).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
